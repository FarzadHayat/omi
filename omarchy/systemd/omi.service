# Written by `omi install`; `omi uninstall` removes it.
[Unit]
Description=Omi voice assistant and desktop companion
# Tools act on windows and play audio, so the daemon needs the Wayland session
# uwsm imports before graphical-session.target, and goes with it.
After=graphical-session.target pipewire.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
# The venv's own entry point: about 20 ms quicker to start than `uv run`, and it
# never syncs or downloads anything when the session starts.
ExecStart=@OMI@ daemon
Restart=on-failure
RestartSec=2
# Logs go to the journal: journalctl --user -u omi

[Install]
WantedBy=graphical-session.target
